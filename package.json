{
    "name": "vs-code-snippet-generator",
    "displayName": "VS Code Snippet Generator",
    "description": "Generate VS Code snippet JSON block for selected text or save it straight into a language snippets file",
    "icon": "images/icon.png",
    "publisher": "dkultasev",
    "version": "1.2.0",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Snippets"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "VS Code Snippet Generator",
            "properties": {
                "vs-code-snippet-generator.preserveIndentation": {
                    "type": "boolean",
                    "default": false,
                    "description": "Preserve indentation in snippet body lines instead of trimming leading whitespace."
                }
            }
        },
        "commands": [
            {
                "command": "extension.generateSnippet",
                "title": "Snippet: Generate snippet JSON block"
            },
            {
                "command": "vs-code-snippet-generator.saveSnippet",
                "title": "Snippet: Save snippet to language snippets file"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "pretest": "npm run compile",
        "test": "mocha \"out/test/**/*.test.js\""
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/mocha": "^10.0.0",
        "@types/node": "^20.0.0",
        "@types/vscode": "~1.75.0",
        "eslint": "^9.0.0",
        "mocha": "^10.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/dkultasev/vs-code-snippet-generator.git"
    }
}
